rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Quizly ────────────────────────────────────────────────
    // Contenu : lecture libre, écriture réservée aux admins
    match /questions/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /quizzes/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /themes/{id}     { allow read: if true; allow write: if isAdmin(); }

    // Profils : chacun son document, sans pouvoir se donner isAdmin/isPremium
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == false
        && request.resource.data.isPremium == false;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isPremium']);
    }

    // Classement public : chacun écrit uniquement sa propre ligne
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Défi du jour : un score par joueur et par jour (id = date_uid), non modifiable
    match /daily_scores/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid;
    }

    // Duels entre amis
    match /duels/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.creatorUid == request.auth.uid;
    }
    match /duel_results/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.duelId + '_' + request.auth.uid;
    }

    // Signalements de questions : création par tout joueur connecté, gestion par l'admin
    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── Calendrier partagé (ouvert) ───────────────────────────
    match /calendar_users/{id}  { allow read, write: if true; }
    match /calendar_events/{id} { allow read, write: if true; }

    // ── Autres projets de la même base (inchangé) ─────────────
    match /boutique_produits/{id}        { allow read, write: if true; }
    match /boutique_ventes/{id}          { allow read, write: if true; }
    match /boutique_depenses/{id}        { allow read, write: if true; }
    match /boutique_caisse/{id}          { allow read, write: if true; }
    match /boutique_marges/{id}          { allow read, write: if true; }
    match /boutique_notes/{id}           { allow read, write: if true; }
    match /boutique_reappros/{id}        { allow read, write: if true; }
    match /boutique_investissements/{id} { allow read, write: if true; }
    match /hotelbar/{id}                 { allow read, write: if true; }
  }
}
